{
  "name": "forge-of-azeroth",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Кузница Азерота — браузерная 2D-игра про автоматизацию кузнечного производства",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run vite:build",
    "typecheck": "tsc --noEmit",
    "vite:build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets": "node tools/gen-assets.mjs",
    "levels": "node tools/gen-levels.mjs",
    "sim": "npx tsx tools/simulator.ts"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "idb-keyval": "^6.2.1",
    "lottie-react": "^2.4.0",
    "pixi.js": "^8.6.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/howler": "^2.2.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
